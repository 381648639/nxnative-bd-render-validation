+++ b/dm/gfx/nvn/nvn_compile_queue.h
@@ -0,0 +1,35 @@
+#ifndef NVN_COMPILE_QUEUE_H
+#define NVN_COMPILE_QUEUE_H
+
+#import <Foundation/Foundation.h>
+#include <stdio.h>
+
+// A global concurrent queue does not bound synchronous Metal compiler clients.
+// Waiting clients can exhaust its worker pool while the compiler needs workers
+// from that same pool. Admission must happen before executing the client block,
+// not with a semaphore that parks another global worker for every prediction.
+enum { NVN_COMPILE_CONCURRENCY = 2 };
+static NSOperationQueue *nvn_compile_queue(void) {
+    static NSOperationQueue *queue;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        queue = [NSOperationQueue new];
+        queue.name = @"org.nxnative.pipeline-compile";
+        queue.qualityOfService = NSQualityOfServiceUserInitiated;
+        queue.maxConcurrentOperationCount = NVN_COMPILE_CONCURRENCY;
+        fprintf(stderr, "[pipeline-compile] speculative compiler clients limited to %d; demanded work has priority\n", NVN_COMPILE_CONCURRENCY);
+    });
+    return queue;
+}
+
+// A15 / iOS 16 reported an internal compiler error while serializing an archive
+// and stopped producing frames. Moving serialization off our mutex cannot
+// isolate Apple's shared compiler service. Keep the legacy iOS path free of
+// optional binary-archive work; ordinary pipeline and in-memory PSO caches stay
+// available. This is a conservative driver fallback, not proof of the hang's
+// complete cause. Newer systems retain the existing persistence path.
+static int nvn_binary_archive_allowed(int is_ios, NSInteger major_version) {
+    return !is_ios || major_version >= 18;
+}
+
+#endif
