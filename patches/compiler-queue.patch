+++ b/dm/gfx/tests/t_compile_queue.m
@@ -0,0 +1,79 @@
+// Exercise actual admission and demanded-work priority with blocked compiler
+// clients, then compile real pipelines through the same scheduler.
+#include "../nvn/nvn_compile_queue.h"
+#import <Metal/Metal.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <unistd.h>
+
+static _Atomic int active, peak, started, failed, checks;
+static dispatch_semaphore_t entered, release_client, finished;
+static int order[32];
+#define CHECK(name, condition) do { int ok = !!(condition); checks++; failed += !ok; printf("%s: %s\n", name, ok ? "PASS" : "FAIL"); } while (0)
+static int wait_for(dispatch_semaphore_t sem, double seconds) {
+    return !dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, (int64_t)(seconds * NSEC_PER_SEC)));
+}
+static void client(int index) {
+    int n = atomic_fetch_add(&active, 1) + 1;
+    int old = peak;
+    while (n > old && !atomic_compare_exchange_weak(&peak, &old, n)) {}
+    int pos = atomic_fetch_add(&started, 1);
+    order[pos] = index;
+    dispatch_semaphore_signal(entered);
+    dispatch_semaphore_wait(release_client, DISPATCH_TIME_FOREVER);
+    atomic_fetch_sub(&active, 1);
+    dispatch_semaphore_signal(finished);
+}
+int main(int argc, char **argv) { @autoreleasepool {
+    alarm(30); setbuf(stdout, NULL);
+    int baseline = argc > 1 && !strcmp(argv[1], "baseline");
+    entered = dispatch_semaphore_create(0);
+    release_client = dispatch_semaphore_create(0);
+    finished = dispatch_semaphore_create(0);
+    CHECK("iOS 16 optional archive work is excluded", !nvn_binary_archive_allowed(1, 16));
+    CHECK("iOS 17 uses the conservative legacy policy", !nvn_binary_archive_allowed(1, 17));
+    CHECK("iOS 18 keeps the newer archive path", nvn_binary_archive_allowed(1, 18));
+    CHECK("Mac archive testing remains enabled", nvn_binary_archive_allowed(0, 14));
+    enum { count = 24 };
+    NSMutableArray<NSBlockOperation *> *jobs = [NSMutableArray array];
+    for (int i = 0; i < count; i++) {
+        NSBlockOperation *job = [NSBlockOperation blockOperationWithBlock:^{ client(i); }];
+        [jobs addObject:job];
+    }
+    if (baseline) {
+        for (int i = 0; i < count; i++) dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ client(i); });
+    } else {
+        for (NSBlockOperation *job in jobs) [nvn_compile_queue() addOperation:job];
+    }
+    CHECK("first compiler client starts", wait_for(entered, 3));
+    CHECK("second compiler client starts", wait_for(entered, 3));
+    int third = wait_for(entered, 0.3);
+    CHECK("speculative compiler admission is bounded before execution", !third && peak == NVN_COMPILE_CONCURRENCY);
+    if (!baseline) {
+        jobs.lastObject.queuePriority = NSOperationQueuePriorityVeryHigh;
+        dispatch_semaphore_signal(release_client);
+        CHECK("demanded queued client starts after a slot is released", wait_for(entered, 3));
+        CHECK("actual draw is promoted ahead of remaining guesses", order[2] == count - 1);
+    }
+    for (int i = 0; i < count; i++) dispatch_semaphore_signal(release_client);
+    for (int i = 0; i < count; i++) CHECK("compiler job completes", wait_for(finished, 3));
+    if (!baseline) {
+        [nvn_compile_queue() waitUntilAllOperationsAreFinished];
+        CHECK("all pending clients finish with no slot leaks", active == 0 && started == count && peak == NVN_COMPILE_CONCURRENCY);
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        NSError *error = nil;
+        id<MTLLibrary> lib = [device newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\nvertex float4 v(uint i [[vertex_id]]) { return float4(i & 1, i >> 1, 0, 1); }\nfragment float4 f() { return float4(1); }\n" options:nil error:&error];
+        CHECK("real test Metal source compiles", lib != nil);
+        for (int i = 0; i < 12; i++) [nvn_compile_queue() addOperationWithBlock:^{ @autoreleasepool {
+            MTLRenderPipelineDescriptor *d = [MTLRenderPipelineDescriptor new];
+            d.vertexFunction = [lib newFunctionWithName:@"v"];
+            d.fragmentFunction = [lib newFunctionWithName:@"f"];
+            d.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+            NSError *e = nil;
+            CHECK("queued real render pipeline remains valid", [device newRenderPipelineStateWithDescriptor:d error:&e] != nil);
+        } }];
+        [nvn_compile_queue() waitUntilAllOperationsAreFinished];
+    }
+    printf("compile scheduler: %d checks, %d failed; peak clients %d\n", checks, failed, peak);
+    return failed != 0;
+} }
