diff --git a/dm/host/hle_unity_quality.c b/dm/host/hle_unity_quality.c
new file mode 100644
--- /dev/null
+++ b/dm/host/hle_unity_quality.c
@@ -0,0 +1,58 @@
+// QualitySettings.shadowResolution follows the verified native Unity setter.
+// Lowering its enum leaves scene resolution, geometry, UI and shadows enabled.
+#include "hle.h"
+#include "hle_unity.h"
+#include <mach/mach.h>
+
+static int quality_read(uint64_t at, void *out, size_t size) {
+    vm_size_t got = 0;
+    return at >= 0x1000 && vm_read_overwrite(mach_task_self(), (vm_address_t)at,
+        size, (vm_address_t)out, &got) == KERN_SUCCESS && got == size;
+}
+
+void dm_unity_quality_tick(void) {
+    static uint64_t saved_object, saved_table;
+    static int original[16], applied[16], seen[16], reports;
+    const char *choice = getenv("DM_SHADOW_QUALITY");
+    if (!choice) choice = DM_GAME_SHADOW_QUALITY;
+    int cap = -1;
+    if (!strcmp(choice, "balanced")) cap = 1;
+    else if (!strcmp(choice, "low")) cap = 0;
+    else if (strcmp(choice, "native")) {
+        static int warned;
+        if (!warned++) LOG("[RED] DM_SHADOW_QUALITY: expected native, balanced or low; keeping original quality");
+    }
+    if (cap < 0 && !saved_object) return;
+    for (int i = 0; i < g_nmod; i++) {
+        const module_t *m = &g_mod[i];
+        if (strcmp(m->name, "main") || strcmp(m->build_id, "94ceae325c205c4b9d6f7235552f28fd")) continue;
+        // Native icall +0xddd260 -> +0x464360: Manager(11), data at
+        // object+0x30, current level at +0x4c, stride 0xa8, enum at +0x30.
+        // The setter clamps to 0..3 and only stores that 32-bit field.
+        // Manager(11) is main+0x4f3e088 + 11*8 (+0x57e120).
+        uint64_t base = (uint64_t)(uintptr_t)m->base, object, vtable, table;
+        int level, current;
+        if (!quality_read(base + 0x4f3e0e0, &object, 8) || !object || (object & 7) ||
+            !quality_read(object, &vtable, 8) || vtable < base + 0x2cf7000 || vtable >= base + 0x5070000 ||
+            !quality_read(object + 0x30, &table, 8) || !table || (table & 7) ||
+            !quality_read(object + 0x4c, &level, 4) || level < 0 || level >= 16) return;
+        uint64_t address = table + (uint64_t)level * 0xa8 + 0x30;
+        if (!quality_read(address, &current, 4) || current < 0 || current > 3) return;
+        if (object != saved_object || table != saved_table) {
+            memset(seen, 0, sizeof seen);
+            saved_object = object; saved_table = table;
+        }
+        if (!seen[level] || current != applied[level]) original[level] = current;
+        seen[level] = 1;
+        int want = cap < 0 || original[level] <= cap ? original[level] : cap;
+        applied[level] = current;
+        if (current == want) return;
+        uint32_t *field = (uint32_t *)(uintptr_t)address, expected = current;
+        dm_guest_write_prepare(field, sizeof *field);
+        if (__atomic_compare_exchange_n(field, &expected, (uint32_t)want, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+            applied[level] = want;
+            if (reports++ < 12) LOG("main: Unity shadow quality %s: level %d, enum %d -> %d", choice, level, current, want);
+        }
+        return;
+    }
+}
