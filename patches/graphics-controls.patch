diff --git a/dm/host/tests/t_unity_quality.c b/dm/host/tests/t_unity_quality.c
new file mode 100644
--- /dev/null
+++ b/dm/host/tests/t_unity_quality.c
@@ -0,0 +1,80 @@
+// The real native-field controller: restore, level changes and invalid objects.
+#include "../hle_unity_quality.c"
+#include <assert.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static module_t modules[1];
+module_t *g_mod = modules;
+int g_nmod = 1;
+static int writes;
+void dm_guest_write_prepare(void *p, size_t n) { assert(!((uintptr_t)p & 3) && n == 4); writes++; }
+
+static void run_case(int which) {
+    size_t size = 0x5000000;
+    uint8_t *base = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(base != MAP_FAILED);
+    uint64_t object[16] = {0};
+    uint32_t levels[16 * 0xa8 / 4];
+    memset(levels, 0x11, sizeof levels);
+    uint32_t *shadow = &levels[0x30 / 4];
+    *shadow = 3;
+    strcpy(g_mod[0].name, "main");
+    strcpy(g_mod[0].build_id, "94ceae325c205c4b9d6f7235552f28fd");
+    g_mod[0].base = base;
+    *(uintptr_t *)(base + 0x4f3e0e0) = (uintptr_t)object;
+    object[0] = (uintptr_t)base + 0x4aec800;
+    object[0x30 / 8] = (uintptr_t)levels;
+    int *level = (int *)((uint8_t *)object + 0x4c);
+    *level = 0;
+    setenv("DM_SHADOW_QUALITY", "balanced", 1);
+    if (which == 0) setenv("DM_SHADOW_QUALITY", "native", 1);
+    if (which == 2) setenv("DM_SHADOW_QUALITY", "low", 1);
+    if (which == 3) *shadow = 0;
+    if (which == 4) g_mod[0].build_id[0] = '0';
+    if (which == 5) object[0] = 0x10000;
+    if (which == 6) *(uintptr_t *)(base + 0x4f3e0e0) = 0;
+    if (which == 7) object[0x30 / 8] = 0x10000;
+    if (which == 8) *level = 16;
+    if (which == 9) *shadow = 4;
+    if (which == 10) setenv("DM_SHADOW_QUALITY", "invalid", 1);
+    dm_unity_quality_tick();
+    if (which == 0 || (which >= 3 && which <= 10)) assert(writes == 0);
+    else {
+        assert(*shadow == (which == 2 ? 0 : 1) && writes == 1);
+        assert(shadow[-1] == 0x11111111 && shadow[1] == 0x11111111);
+        for (int i = 0; i < 60; i++) dm_unity_quality_tick();
+        assert(writes == 1);
+        if (which == 11) {
+            *level = 1;
+            levels[(0xa8 + 0x30) / 4] = 2;
+            dm_unity_quality_tick();
+            assert(levels[(0xa8 + 0x30) / 4] == 1 && writes == 2);
+            setenv("DM_SHADOW_QUALITY", "native", 1);
+            dm_unity_quality_tick();
+            assert(levels[(0xa8 + 0x30) / 4] == 2);
+            *level = 0;
+        }
+        setenv("DM_SHADOW_QUALITY", "native", 1);
+        dm_unity_quality_tick();
+        assert(*shadow == 3);
+        // A new game quality request becomes the original value restored later.
+        *shadow = 2;
+        setenv("DM_SHADOW_QUALITY", "low", 1);
+        dm_unity_quality_tick(); assert(*shadow == 0);
+        setenv("DM_SHADOW_QUALITY", "native", 1);
+        dm_unity_quality_tick(); assert(*shadow == 2);
+    }
+    munmap(base, size);
+}
+
+int main(void) {
+    for (int i = 0; i < 12; i++) {
+        pid_t child = fork(); assert(child >= 0);
+        if (!child) { run_case(i); _exit(0); }
+        int status; assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    }
+    puts("Unity shadow quality: native/balanced/low, no increase, level changes, restore, build and pointer guards passed");
+}
