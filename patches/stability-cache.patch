diff --git a/dm/gfx/tests/t_pipeline_cache.m b/dm/gfx/tests/t_pipeline_cache.m
new file mode 100644
--- /dev/null
+++ b/dm/gfx/tests/t_pipeline_cache.m
@@ -0,0 +1,161 @@
+// Traditional Metal cache: recording/serialization cannot gate demanded PSOs.
+#include "../nvn/nvn_pipeline_cache.m"
+#include <assert.h>
+#include <stdatomic.h>
+
+static _Atomic int checks, failed;
+#define CHECK(name, ok) do { int pass = !!(ok); checks++; failed += !pass; printf("%s: %s\n", name, pass ? "PASS" : "FAIL"); } while (0)
+static dispatch_semaphore_t entered, release_work;
+static _Atomic int block_add, block_write, fail_write;
+static _Atomic int builds, lookups, wrong_lookup;
+static id expected_read;
+static id<MTLFunction> test_vertex, test_compute;
+
+@interface CacheArchive : NSObject
+@end
+@implementation CacheArchive
+- (BOOL)addRenderPipelineFunctionsWithDescriptor:(id)d error:(NSError **)error {
+    (void)d; (void)error;
+    if (block_add) { dispatch_semaphore_signal(entered); dispatch_semaphore_wait(release_work, DISPATCH_TIME_FOREVER); }
+    return YES;
+}
+- (BOOL)addComputePipelineFunctionsWithDescriptor:(id)d error:(NSError **)error {
+    return [self addRenderPipelineFunctionsWithDescriptor:d error:error];
+}
+- (BOOL)serializeToURL:(NSURL *)url error:(NSError **)error {
+    if (block_write) { dispatch_semaphore_signal(entered); dispatch_semaphore_wait(release_work, DISPATCH_TIME_FOREVER); }
+    [@"recorded-cache" writeToURL:url atomically:NO encoding:NSUTF8StringEncoding error:nil];
+    if (fail_write && error) *error = [NSError errorWithDomain:@"InjectedArchiveFailure" code:1 userInfo:nil];
+    return !fail_write;
+}
+@end
+
+@interface CacheDevice : NSObject
+@end
+@implementation CacheDevice
+- (id)newRenderPipelineStateWithDescriptor:(id)d error:(NSError **)error {
+    (void)d; if (error) *error = nil; atomic_fetch_add(&builds, 1); return [NSObject new];
+}
+- (id)newComputePipelineStateWithFunction:(id)function error:(NSError **)error {
+    return [self newRenderPipelineStateWithDescriptor:function error:error];
+}
+- (id)newRenderPipelineStateWithDescriptor:(MTLRenderPipelineDescriptor *)d options:(NSUInteger)options reflection:(id *)reflection error:(NSError **)error {
+    (void)options; (void)reflection; if (error) *error = nil;
+    atomic_fetch_add(&lookups, 1);
+    if (expected_read && d.binaryArchives.firstObject != expected_read) atomic_fetch_add(&wrong_lookup, 1);
+    return expected_read && d.binaryArchives.firstObject == expected_read ? [NSObject new] : nil;
+}
+- (id)newComputePipelineStateWithDescriptor:(MTLComputePipelineDescriptor *)d options:(NSUInteger)options reflection:(id *)reflection error:(NSError **)error {
+    return [self newRenderPipelineStateWithDescriptor:(id)d options:options reflection:reflection error:error];
+}
+@end
+
+static MTLRenderPipelineDescriptor *descriptor(void) {
+    MTLRenderPipelineDescriptor *d = [MTLRenderPipelineDescriptor new];
+    d.vertexFunction = test_vertex;
+    d.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    return d;
+}
+static id render(void) { NSError *error = nil; return nvn_cached_render((id)[CacheDevice new], descriptor(), &error); }
+static id compute(void) { NSError *error = nil; return nvn_cached_compute((id)[CacheDevice new], test_compute, &error); }
+static int signal_within(dispatch_semaphore_t signal, double seconds) {
+    return dispatch_semaphore_wait(signal, dispatch_time(DISPATCH_TIME_NOW, seconds * NSEC_PER_SEC)) == 0;
+}
+static void prepare_mock(NSString *folder) {
+    id<MTLLibrary> library = [MTLCreateSystemDefaultDevice() newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\nvertex float4 vertex_main(uint i [[vertex_id]]) { return float4(float(i),0,0,1); }\nkernel void compute_main(device uint *p [[buffer(0)]], uint i [[thread_position_in_grid]]) { p[i]=i; }\n" options:nil error:nil];
+    assert(library);
+    test_vertex = [library newFunctionWithName:@"vertex_main"];
+    test_compute = [library newFunctionWithName:@"compute_main"];
+    initialized = 1; archive = (id)[CacheArchive new];
+    cache_file = [folder stringByAppendingPathComponent:@"pipelines.metalarc"];
+    entered = dispatch_semaphore_create(0); release_work = dispatch_semaphore_create(0);
+}
+static void demand_while_blocked(void) {
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        CHECK("render returns a valid first-use PSO", render() != nil);
+        CHECK("compute returns a valid first-use PSO", compute() != nil);
+        nvn_cache_status status; nvn_cache_snapshot(&status);
+        dispatch_semaphore_signal(done);
+    });
+    int returned = signal_within(done, 1);
+    CHECK("demands and diagnostics finish while archive work is held", returned);
+    // A second/third add must not block after the first held operation returns.
+    block_add = block_write = 0;
+    dispatch_semaphore_signal(release_work);
+    CHECK("demand task completed", returned || signal_within(done, 2));
+    nvn_cache_flush();
+}
+static void mock_case(const char *mode, NSString *folder) {
+    prepare_mock(folder);
+    if (!strcmp(mode, "add")) {
+        block_add = 1;
+        dispatch_semaphore_t compiled = dispatch_semaphore_create(0);
+        dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ render(); dispatch_semaphore_signal(compiled); });
+        CHECK("recording entered", signal_within(entered, 2));
+        CHECK("original demand returns before recording finishes", signal_within(compiled, 1));
+        demand_while_blocked();
+    } else if (!strcmp(mode, "write")) {
+        render(); block_write = 1; nvn_cache_flush_async();
+        CHECK("serializer entered", signal_within(entered, 2));
+        demand_while_blocked();
+    } else if (!strcmp(mode, "failure")) {
+        [@"previous-cache" writeToFile:cache_file atomically:NO encoding:NSUTF8StringEncoding error:nil];
+        render(); fail_write = 1; nvn_cache_flush();
+        CHECK("write failure reported", stats.write_failed);
+        CHECK("previous good file retained", [[NSString stringWithContentsOfFile:cache_file encoding:NSUTF8StringEncoding error:nil] isEqual:@"previous-cache"]);
+        uint64_t added = stats.added;
+        CHECK("render survives failed persistence", render() != nil);
+        CHECK("compute survives failed persistence", compute() != nil);
+        nvn_cache_flush();
+        CHECK("failed writer stops accepting new records", stats.added == added);
+#ifdef CACHE_PENDING_MAX
+    } else if (!strcmp(mode, "lookup")) {
+        expected_read = [CacheArchive new]; read_archive = (id)expected_read;
+        CHECK("render archive hit succeeds", render() != nil);
+        CHECK("compute archive hit succeeds", compute() != nil);
+        CHECK("lookups use the independent immutable archive", atomic_load(&lookups) == 2 && !atomic_load(&wrong_lookup));
+        CHECK("hits do not compile or record", !atomic_load(&builds) && stats.hits == 2 && !pending_records);
+    } else if (!strcmp(mode, "bound")) {
+        block_add = 1; render();
+        CHECK("recording held", signal_within(entered, 2));
+        int all_built = 1;
+        for (unsigned i = 0; i < CACHE_PENDING_MAX + 8; ++i) all_built &= render() != nil;
+        CHECK("flooded demands remain usable", all_built);
+        pthread_mutex_lock(&cache_mu); unsigned pending = pending_records; pthread_mutex_unlock(&cache_mu);
+        CHECK("pending descriptor retention stays bounded", pending == CACHE_PENDING_MAX && stats.bypassed >= 9);
+        block_add = 0; dispatch_semaphore_signal(release_work); nvn_cache_flush();
+#endif
+    } else { fprintf(stderr, "Unknown cache case\n"); exit(2); }
+}
+static void real_case(const char *mode, NSString *folder) {
+    setenv("DM_PIPELINE_CACHE_DIR", folder.fileSystemRepresentation, 1);
+    NSString *shmap = [folder stringByAppendingPathComponent:@"shader_map.tsv"];
+    [@"cache-test\n" writeToFile:shmap atomically:NO encoding:NSUTF8StringEncoding error:nil];
+    setenv("DM_NVN_SHMAP", shmap.fileSystemRepresentation, 1);
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice(); assert(device);
+    NSError *error = nil;
+    NSString *source = @"#include <metal_stdlib>\nusing namespace metal;\nvertex float4 vertex_main(uint i [[vertex_id]]) { return float4(float(i),0,0,1); }\nfragment float4 fragment_main() { return float4(1); }\nkernel void compute_main(device uint *p [[buffer(0)]], uint i [[thread_position_in_grid]]) { p[i]=i; }\n";
+    id<MTLLibrary> library = [device newLibraryWithSource:source options:nil error:&error]; assert(library);
+    MTLRenderPipelineDescriptor *d = [MTLRenderPipelineDescriptor new];
+    d.vertexFunction = [library newFunctionWithName:@"vertex_main"];
+    d.fragmentFunction = [library newFunctionWithName:@"fragment_main"];
+    d.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    CHECK("real render pipeline built", nvn_cached_render(device, d, &error) != nil);
+    CHECK("real compute pipeline built", nvn_cached_compute(device, [library newFunctionWithName:@"compute_main"], &error) != nil);
+    nvn_cache_flush();
+    if (!strcmp(mode, "seed")) CHECK("real archive saved both pipelines", stats.saved == 2 && !stats.write_failed);
+    else {
+        CHECK("compatible archive loaded on a fresh process", stats.loaded);
+        CHECK("both fresh-process pipelines hit the saved archive", stats.hits == 2 && !stats.misses);
+    }
+}
+int main(int argc, char **argv) { @autoreleasepool {
+    alarm(30); setbuf(stdout, NULL); if (argc != 3) return 2;
+    NSString *folder = @(argv[2]);
+    [NSFileManager.defaultManager createDirectoryAtPath:folder withIntermediateDirectories:YES attributes:nil error:nil];
+    if (!strcmp(argv[1], "seed") || !strcmp(argv[1], "replay")) real_case(argv[1], folder);
+    else mock_case(argv[1], folder);
+    printf("traditional pipeline cache: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
