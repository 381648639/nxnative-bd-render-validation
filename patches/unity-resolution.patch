diff --git a/dm/host/tests/t_unity_screen.c b/dm/host/tests/t_unity_screen.c
new file mode 100644
--- /dev/null
+++ b/dm/host/tests/t_unity_screen.c
@@ -0,0 +1,78 @@
+// Exercise native resize requests, without rendering or shipping game data.
+#include "../hle_unity_screen.c"
+#include <assert.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static module_t modules[1];
+module_t *g_mod = modules;
+int g_nmod = 1;
+static int mode, writes;
+int dm_opmode(void) { return mode; }
+void dm_guest_write_prepare(void *p, size_t n) { assert(!((uintptr_t)p & 7) && n == 8); writes++; }
+
+static void run_case(int which) {
+    size_t size = 0x5000000;
+    uint8_t *base = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(base != MAP_FAILED);
+    uint64_t object[16] = {0};
+    strcpy(g_mod[0].name, "main");
+    strcpy(g_mod[0].build_id, "94ceae325c205c4b9d6f7235552f28fd");
+    g_mod[0].base = base;
+    *(uintptr_t *)(base + 0x4efe760) = (uintptr_t)object;
+    object[0] = (uintptr_t)base + 0x4aec580;
+    object[1] = UINT64_MAX;   // no pending width/height
+    object[2] = 0x1122334455667788ull;   // fullscreen/refresh fields must survive
+    int *current = (int *)((uint8_t *)object + 0x68);
+    current[0] = 1280; current[1] = 720;
+    setenv("DM_SCREEN_RESOLUTION", "960x540", 1);
+    if (which == 0) setenv("DM_SCREEN_RESOLUTION", "native", 1);
+    if (which == 2) setenv("DM_SCREEN_RESOLUTION", "640x360", 1);
+    if (which == 3) { mode = 1; current[0] = 1920; current[1] = 1080; setenv("DM_SCREEN_RESOLUTION", "1280x720", 1); }
+    if (which == 4) g_mod[0].build_id[0] = '0';
+    if (which == 5) object[0]++;
+    if (which == 6) *(uintptr_t *)(base + 0x4efe760) = 0;
+    if (which == 7) *(uintptr_t *)(base + 0x4efe760) = 0x10000;
+    if (which == 8) current[0] = 0;
+    if (which >= 9 && which <= 12) {
+        const char *bad[] = {"nan", "0.4", "2", "0.75x"};
+        setenv("DM_SCREEN_RESOLUTION", bad[which - 9], 1);
+    }
+    dm_unity_screen_tick();
+    if (which == 0 || which >= 4) {
+        assert(writes == 0 && object[1] == UINT64_MAX);
+    } else {
+        int w = which == 2 ? 640 : which == 3 ? 1280 : 960;
+        int h = which == 2 ? 360 : which == 3 ? 720 : 540;
+        assert(object[1] == ((uint32_t)w | (uint64_t)(uint32_t)h << 32));
+        assert(writes == 1 && object[2] == 0x1122334455667788ull);
+        // Simulate Unity consuming its request. Steady frames must not request
+        // repeated reallocations, even when the game clears the pending pair.
+        current[0] = w; current[1] = h;
+        for (int i = 0; i < 60; i++) dm_unity_screen_tick();
+        assert(writes == 1);
+        object[1] = UINT64_MAX;
+        dm_unity_screen_tick(); assert(writes == 1);
+        // A later native-size request is scaled again, without changing the
+        // fullscreen/refresh fields or progressively multiplying the old size.
+        object[1] = 1280 | (uint64_t)720 << 32;
+        dm_unity_screen_tick(); assert(writes == 2);
+        assert((uint32_t)object[1] == (uint32_t)w);
+        setenv("DM_SCREEN_RESOLUTION", "native", 1);
+        dm_unity_screen_tick();
+        assert((uint32_t)object[1] == (uint32_t)(mode ? 1920 : 1280));
+        assert((uint32_t)(object[1] >> 32) == (uint32_t)(mode ? 1080 : 720));
+    }
+    munmap(base, size);
+}
+
+int main(void) {
+    for (int i = 0; i < 13; i++) {
+        pid_t child = fork(); assert(child >= 0);
+        if (!child) { run_case(i); _exit(0); }
+        int status; assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    }
+    puts("Unity screen: native/720p/540p/360p, restore, stable requests, build/vtable gates, invalid and unreadable data passed");
+}
