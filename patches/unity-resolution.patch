diff --git a/dm/host/hle_unity_screen.c b/dm/host/hle_unity_screen.c
new file mode 100644
--- /dev/null
+++ b/dm/host/hle_unity_screen.c
@@ -0,0 +1,70 @@
+// Unity's native Screen.SetResolution request, for verified engine builds.
+// This reduces the game view itself (including its UI), before render targets
+// are allocated. It does not scale only the final Metal presentation copy.
+#include "hle.h"
+#include <mach/mach.h>
+
+static int screen_read(uint64_t a, void *out, size_t n) {
+    vm_size_t got = 0;
+    return a >= 0x1000 && vm_read_overwrite(mach_task_self(), (vm_address_t)a,
+        n, (vm_address_t)out, &got) == KERN_SUCCESS && got == n;
+}
+
+static const struct {
+    const char *build;
+    uint64_t root, vtable;
+    uint32_t request, current;
+    int width[2], height[2];   // handheld, docked
+} unity_screens[] = {
+    // Brilliant Diamond 1.3.0, Unity 2019.4.27f1. Screen's icall registration
+    // at +0xe36b54 resolves to +0xdd8930, then ScreenManager vtable +0x10:
+    // +0x4652d4 stores the width/height pair at object+8. Unity applies the
+    // request through its normal resize path (+0x2c2898); current extents are
+    // object+0x68/+0x6c. The constructor installs vtable +0x4aec580.
+    { "94ceae325c205c4b9d6f7235552f28fd", 0x4efe760, 0x4aec580,
+      8, 0x68, {1280, 1920}, {720, 1080} },
+};
+
+void dm_unity_screen_tick(void) {
+    static int modified, reports, invalid_reported;
+    const char *resolution = getenv("DM_SCREEN_RESOLUTION");
+    if (!resolution) resolution = DM_GAME_SCREEN_RESOLUTION;
+    int width = 0, height = 0;
+    if (!strcmp(resolution, "1280x720")) { width = 1280; height = 720; }
+    else if (!strcmp(resolution, "960x540")) { width = 960; height = 540; }
+    else if (!strcmp(resolution, "640x360")) { width = 640; height = 360; }
+    else if (strcmp(resolution, "native")) {
+        if (!invalid_reported++) LOG("[RED] DM_SCREEN_RESOLUTION: expected native, 1280x720, 960x540 or 640x360; using the game's original resolution");
+    }
+    int selected = width != 0;
+    if (!selected && !modified) return;   // bit-exact original behavior
+    for (int k = 0; k < (int)(sizeof unity_screens / sizeof *unity_screens); k++) {
+        const __typeof__(*unity_screens) *s = &unity_screens[k];
+        for (int i = 0; i < g_nmod; i++) {
+            if (strcmp(g_mod[i].name, "main") || strcmp(g_mod[i].build_id, s->build)) continue;
+            uint64_t base = (uint64_t)(uintptr_t)g_mod[i].base, object, vtable, pending;
+            int current[2];
+            if (!screen_read(base + s->root, &object, sizeof object) || !object || (object & 7) ||
+                !screen_read(object, &vtable, sizeof vtable) || vtable != base + s->vtable ||
+                !screen_read(object + s->current, current, sizeof current) ||
+                !screen_read(object + s->request, &pending, sizeof pending)) return;
+            if (current[0] < 1 || current[0] > 1920 || current[1] < 1 || current[1] > 1080) return;
+            int mode = dm_opmode() == 1;
+            if (!selected) { width = s->width[mode]; height = s->height[mode]; }
+            uint64_t want = (uint32_t)width | (uint64_t)(uint32_t)height << 32;
+            if (pending == want) return;
+            int32_t pw = (int32_t)pending, ph = (int32_t)(pending >> 32);
+            if ((pw != -1 && (pw < 1 || pw > 1920)) || (ph != -1 && (ph < 1 || ph > 1080))) return;
+            if (current[0] == width && current[1] == height && pw == -1 && ph == -1) return;
+            uint64_t *p = (uint64_t *)(uintptr_t)(object + s->request);
+            dm_guest_write_prepare(p, sizeof *p);
+            // A single aligned pair preserves width/height together. Do not
+            // overwrite a different request that the game wrote since our read.
+            if (__atomic_compare_exchange_n(p, &pending, want, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+                modified = selected;
+                if (reports++ < 12) LOG("main: Unity screen resolution request %dx%d (%s); current %dx%d", width, height, mode ? "docked" : "handheld", current[0], current[1]);
+            }
+            return;
+        }
+    }
+}
